# Serving configuration of the native R2 release on 4x H200 NVL (141 GB per GPU), read by scripts/serve_fpr.sh
# (bash syntax; sourced; FPR_CONFIG points here). The flags are described in fpr/config/fprv1.env and where the engine
# reads them. The native loop switches on top of this file are in deploy/h200/native.env (NATIVE_SW); where both set
# a variable (C1M_*, ENG_HSDT*), NATIVE_SW wins.
#
# KV and every weight live in HBM. Engine pieces: the idx2f indexer, the engine's own Engram, the fused head (hsd) with
# the moe_v4 decode experts; decode buckets up to 320 rows per GPU; 3.5 GB of cached mixed-step buckets.
FPR_ENGINE="indexer=idx2f,engram=phys,head=hsd,hsd_fold=1,hsd_mhc2=1,mixed_bucket_bytes=3500000000,hsd_moe=v4,buckets=4:8:32:64:112:120:128:192:224:240:256:320,max_mixed_rows=2368"
FPR_FLAGS="ENG_LONG_GRAPHS=1 IDX2F_CANON_STOCK=1 PHYS_COST=eager_ctx_above=655360 ENG_AGRS_RSF=1 ENG_AGRS_SUM528=1 ENG_AGRS_AGCE=1 ENG_QB16_MIXED=0 ENG_ATTN_PF=1 ENG_MHCF=1 ENG_QB16_DECODE=0 IDX2F_PF=1 ENG_IDX_FUSE=1 ENG_IDX_SIDE=1 ENG_IDX_F8=1 ENG_G6=1 ENG_AGRS_RSD=1 ENG_LAUNCH_SPLIT=1 ENG_C1_COMM=1 ENG_C1_AGW=1 ENG_C1_PDL=1 ENG_C1_QB_OVERLAP=1 W8A16_DEFS=W8_NTMIN=32 ENG_C1_TPWO=0 ENG_C1_ATTN_HG=1 ENG_C1_ATTN_HG_MAXR=4 ENG_C1_AGRT=1 HSD_TPWO=1 ENG_C1_RSC=1 ENG_C1_RSL=1 HSD_R2R=1 ENG_HSDT=mhcf,par,dmask,xg,c1d,ctxtp,dhead,ctx3 ENG_HSDT_MOD=hsdt_c1e HSDT_C1D_SMAX=4 ENG_C1_MEGA=1 C1M_PKG=kernels/c1mega/srv8x C1M_SRC=c1mega_srv.cu C1M_B16=wqkv,woa8,wob8,sh,qb8 C1M_BUILD=build_srv C1M_IX=1 C1IDX_E0=1 C1M_CUT=none ENG_D13_GT=1 ENG_D13_ERR_EVERY=64 ENG_D13_EMPTY=1 ENG_D13_ADV_SLICE=1 ENG_D13_RES_OWNER=1 ENG_D13_OWNER=1 ENG_D13S=on ENG_MIX_TBL_CAP=1 ENG_MAX_TAIL_ROWS=1536 FPR_PAGECOPY=1 ENG_PF_WS_PREALLOC_MB=1536 ENG_AGRS_WS=2 ENG_MIXED_CXX_PIECES=bd,router,ag,rs,final,moe ENG_MIXED_CXX_RUN=1 ENG_MIXED_PRESTEP=1 ENG_MIXED_CXX_HEAD=1 ENG_D13_TFUSE=1 FPR_ENGRAM_STAGE=8 ENG_WO_W8A16=1 ENG_MIX_ONE_BUCKET=1 ENG_MIXED_CXX_AUX_SHARED=1 ENG_MIX_ONE_BUCKET_T=1 ENG_WO_W8A16_DQ=1 ENG_QB_DQ=1 W8DQ_IMPL=2 IDX2F_TOPK4=256 ENG_MOE_CXX_FUSED=1 ENG_WO_ONECOPY=1"
# Seats (synchronous scheduling); deploy/h200/run_native.sh sets MAX_SEQS / FPR_SEATS from NATIVE_SEATS instead.
FPR_MAX_SEQS=224
# Scheduler (fpr/serve/scheduler.py SchedConfig documents every field): a 12K-token mixed-step target, context-parallel
# prefill from 2,048 uncached tokens and mandatory above 16,384, the tiered CP order, and at least 10 decode-only steps
# between mixed steps under load (R3: fewer, fuller prefill steps; +7-8 % output tok/s on agentic traffic, first token ~+0.6 s).
FPR_SCHED="mixed_target_tokens=12288,mixed_target_fill=1,mixed_target_wait_s=0.0,cp_min=2048,backlog_drain_wait_s=20.0,mixed_target_full_wait_s=0,cp_force_min=16384,cp_force_decode_steps=0,cp_force_room_frac=1.0,cp_force_order=tiered,cp_force_srpt_min_left=131072,mixed_min_decode_steps=10"
FPR_CP=1
FPR_ASYNC=0

# H200 memory and scheduling:
#   PREFILL_CAP  prefill tokens per GPU and mixed step (3,072)
#   STATE_SLOTS  state pool slots (>= seats + CP shadows; deploy/h200/native.env sets 320 for 256 seats)
# max_mixed_rows = the prefill cap + the largest decode bucket (320). engine_reserve_bytes 16 GB keeps the full
# decode-bucket set, one mixed cap, the prefill workspace and the graph pools outside the KV pool sizing.
PREFILL_CAP=${PREFILL_CAP:-3072}
STATE_SLOTS=${STATE_SLOTS:-192}
export PHYS_GEOM=window_pool_bytes=600000000,max_prefill_tokens_per_rank=$PREFILL_CAP,state_pool_slots=$STATE_SLOTS FPR_WORKER_GEOM=1
FPR_ENGINE="${FPR_ENGINE/max_mixed_rows=2368/max_mixed_rows=$((PREFILL_CAP + 320))},engine_reserve_bytes=16000000000"
