# FPRv1 serving configuration, read by scripts/serve_fpr.sh (bash syntax; sourced). The configuration below is the one
# the release was certified with (docs/FPR.md: offline exactness x 3, CP distribution, served sync x 3 and pipelined x 3,
# repeated drains, replays). Change one thing at a time and re-check exactness after any change.
#
# Engine pieces: the indexer of kernels/indexer2f (idx2f), the engine's own Engram (kernels/engram), and the fused head
# of kernels/head (hsd: LM head, sampler and DSpark drafter; hsd_fold and hsd_mhc2 select its certified variants).
FPR_ENGINE="indexer=idx2f,engram=phys,head=hsd,hsd_fold=1,hsd_mhc2=1"
# Engine flags. All keep 16-bit activations; each is described where it is read:
#   ENG_LONG_GRAPHS        decode steps with rows past 262,144 positions replay the bucket's long graphed variant
#                          instead of the eager mixed path (engine/engine.py)
#   IDX2F_CANON_STOCK      the indexer's top-k lists in the stock persistent top-k's canonical order (ascending, -1 last),
#                          so eager and graphed steps select the same lists
#   PHYS_COST              decode runs eager only for rows beyond 655,360 positions
#   ENG_AGRS_RSF           the reduce-scatter push fused into production's MoE combine (kernels/agrs/pm_rs.cu)
#   ENG_AGRS_SUM528        the reduce-scatter sum on 528 CTAs instead of 132, same per-element arithmetic
#   ENG_AGRS_AGCE          the all-gather by copy engines (no SMs)
#   ENG_AGRS_RSD           decode buckets: the MoE combine stores each row straight into its owner's reduce-scatter slot
#   ENG_QB16_MIXED         keep the bf16 q_b weights of layers 0..20 for mixed steps
#   ENG_QB16_DECODE        decode buckets above 128 rows use the bf16 q_b too (bitwise)
#   ENG_ATTN_PF            mixed steps: prefill rows through production's prefill attention, decode rows on the decode kernel
#   IDX2F_PF               the indexer's shared-key prefill logits kernel (the same logits bit for bit)
#   ENG_MHCF               the fused mHC boundary (bit-identical to the unfused kernels)
#   ENG_IDX_FUSE           decode buckets: the indexer's top-k writes FlashMLA's slots and lengths directly
#   ENG_IDX_SIDE           decode buckets: the KV-source compressor chain and weights projection on a side branch
#   ENG_IDX_F8             the indexer's "f8" logits kernel family (dense + candidate logits, DeepGEMM's arithmetic)
#   ENG_G6                 the decode MoE input gather "gather6", a bit-identical drop-in (kernels/moe_v4/g6.cu)
#   ENG_LAUNCH_SPLIT       the decode graph in two pieces, launched on all four GPUs in turn so they start closer together
FPR_FLAGS="ENG_LONG_GRAPHS=1 IDX2F_CANON_STOCK=1 PHYS_COST=eager_ctx_above=655360 ENG_AGRS_RSF=1 ENG_AGRS_SUM528=1 ENG_AGRS_AGCE=1 ENG_QB16_MIXED=1 ENG_ATTN_PF=1 ENG_MHCF=1 ENG_QB16_DECODE=1 IDX2F_PF=1 ENG_IDX_FUSE=1 ENG_IDX_SIDE=1 ENG_IDX_F8=1 ENG_G6=1 ENG_AGRS_RSD=1 ENG_LAUNCH_SPLIT=1"
# Seats: 224 concurrent sequences (56 per GPU) for synchronous scheduling.
FPR_MAX_SEQS=224
# Scheduler (serve/scheduler.py SchedConfig, where every field is documented): a 12K-token mixed-step target;
# context-parallel prefill (CP) from 2,048 uncached tokens (cp_min), mandatory above 32,768 (cp_force_min) with the whole
# chunk room for that prompt (cp_force_room_frac); the tiered CP order (cp_force_order, cp_force_srpt_min_left); the
# backlog drain wait (backlog_drain_wait_s). scripts/serve_fpr.sh appends cp_prefill=1 when FPR_CP=1.
FPR_SCHED="mixed_target_tokens=12288,mixed_target_fill=1,mixed_target_wait_s=1.0,cp_min=2048,backlog_drain_wait_s=20.0,mixed_target_full_wait_s=0,cp_force_min=32768,cp_force_decode_steps=0,cp_force_room_frac=1.0,cp_force_order=tiered,cp_force_srpt_min_left=131072"
FPR_CP=1
# Synchronous scheduling by default. ASYNC=1 (pipelined decode dispatch) is certified too and is the decode-heavy
# option: ASYNC=1 MAX_SEQS=256 scripts/serve_fpr.sh
FPR_ASYNC=0
