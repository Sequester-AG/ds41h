+    def count_reasoning_tokens_after_prompt_end(
+        self, token_ids: Sequence[int], *, finished: bool = False
+    ) -> int:
+        """Count for a stream whose prompt already closed reasoning: starts in
+        CONTENT, parses only the tokens new since the last call, and flushes
+        once at the end of the stream, so the final count matches a full parse."""
+        engine = self._incremental_counting_engine
+        if (
+            engine is None
+            or len(token_ids) < self._incremental_counted
+            or (self._incremental_flushed and len(token_ids) > self._incremental_counted)
+        ):
+            if engine is None:
+                engine = self._parser_engine_cls(
+                    self.model_tokenizer, **self._parser_engine_kwargs
+                )  # type: ignore[call-arg]
+                self._incremental_counting_engine = engine
+            engine._reset(initial_state=ParserState.CONTENT)
+            self._incremental_counted = 0
+            self._incremental_flushed = False
+        new_ids = token_ids[self._incremental_counted :]
+        if new_ids:
+            engine._feed(self.model_tokenizer.decode(new_ids), new_ids)
+            self._incremental_counted = len(token_ids)
+        if finished and not self._incremental_flushed:
+            engine._engine.finish()
+            self._incremental_flushed = True
+        return engine.count_reasoning_tokens(token_ids)
+
     def count_reasoning_tokens(self, token_ids: Sequence[int]) -> int:
         if self._streaming_count_valid:
             return self._parser_engine.count_reasoning_tokens(token_ids)
