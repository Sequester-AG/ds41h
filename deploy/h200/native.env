# Native loop switches of the R2 release on 4x H200 (256 seats). Read by deploy/h200/run_native.sh after site.env;
# switch_native.sh installs a copy as $DS41H_RUN/native.env, which is what the server starts with.
#
#   NATIVE_READY=1   the tree and the native modules are built (deploy/h200/build_native.sh)
#   NATIVE_ROOT      the release root to serve (a checkout of this repository)
#   FPR_CONFIG       the serving configuration (engine, flags, scheduler, memory)
#   NATIVE_SEATS     concurrent sequences (MAX_SEQS)
#   NATIVE_SW        environment for the native loop, exported before the server starts
#
# Required with this release: both head-graph PRECAPTURE_PRELOAD switches 0 (destroying a torch 2.13 CUDA graph can free
# a cuBLAS workspace that a preloaded head graph still uses) and PHYS_KEEP_GRAPHS=1 (set by run_native.sh: every torch
# CUDA graph is kept until the process exits).
NATIVE_READY=1
NATIVE_ROOT=${DS41H_REPO}
FPR_CONFIG=${DS41H_REPO}/fpr/config/h200_native.env
NATIVE_SEATS=256
NATIVE_SW="STATE_SLOTS=320 \
PHYS_CXX_IO_LOG=20 PHYS_CXX_SCHED=1 PHYS_CXX_KV=1 PHYS_CXX_TABLES=1 PHYS_CXX_D13=1 PHYS_CXX_CORE=1 PHYS_CXX_LOOP=1 \
PHYS_CXX_NATIVE=nd PHYS_CXX_ND_DIR=${DS41H_REPO}/packages/nd/fpr/core/src/nd PHYS_CXX_ND_PREBUILT=1 \
PHYS_CXX_CORE_DIR=${DS41H_BUILD}/b2a PHYS_CXX_CORE2B_DIR=${DS41H_BUILD}/b2a \
PHYS_CXX_CORE2B_PROC=${DS41H_REPO}/fpr/core/src/core2b/core2b_proc.py \
PHYS_CXX_SCHED_DIR=${DS41H_BUILD}/b2a PHYS_CXX_BUILD=${DS41H_BUILD}/b2a \
ENG_MIXED_CXX_IDXA=1 ENG_MIXED_CXX_PIECES=embed,engram,bd,router,ag,rs,final,moe,attn_a,idx,attn_b,attn_pf \
ENG_MIXED_CXX_IDXA_STOCK=1 ENG_HEAD_BM_GRAPH=1 ENG_CXX_EMBED_STAGE=1 ENG_DECODE_PRECREATE=1 ENG_MIX_PRECREATE=1 \
ENG_MIX_PERSIST=1 ENG_TAIL_GATHER=1 ENG_TAIL_GATHER_KERNEL=1 ENG_MIX_ENSURE=1 ENG_CXX_TB=1 ND_DECODE_COPIES=1 \
ENG_MIXED_CXX_CP=3 ND_SPAN_CP=1 PHYS_CXX_MIXED_NATIVE=1 PHYS_CXX_MIXED_EXEC=1 \
FPR_LT=1 FPR_LT_WARM=1 \
ENG_D13_LONG=1 ND_LONG=1 C1M_PKG=kernels/c1mega/srv8m C1M_SRC=c1mega_s8mc.cu C1M_BUILD=build_s8mc C1IDX_E0K=1 \
ND_ACCSTAT=1 ND_ACCSTAT_EVERY=4096 ENG_NATIVE_BOUNDARY=1 \
ENG_C1_PRECAPTURE=1 ENG_DECODE_HEAD_PRECAPTURE=1 ENG_MIXED_HEAD_PRECAPTURE=1 ENG_MIXED_HEAD_PRECAPTURE_KEYS=all \
ENG_MIXED_HEAD_GRAPHS=3350 ENG_MIXED_HEAD_MAX_BM_KEYS=3350 ENG_PRECAP_EST_GB=7 ENG_PRECAP_MIN_FREE_GB=8 ENG_PRECAP_DEFER=1 \
ND_PUB_FAST=0 ENG_MIXED_HEAD_GUARD_CXX=1 PHYS_CXX_H1_EPOCH=1 ND_H1_SCAN_SKIP=1 PHYS_CXX_ENS_NATIVE=1 \
ENG_DECODE_HEAD_PRECAPTURE_PRELOAD=0 ENG_MIXED_HEAD_PRECAPTURE_PRELOAD=0 PHYS_CXX_ONCTX_LAZY=1 \
ENG_HSDT=mhcf,par,dmask,xg,c1d=s8m_nox2,ctxtp,dhead,ctx3 ENG_HSDT_MOD=hsdt_c1m3e"
# Optional: FPR_LT_WARM_FILES=<base>[:<base>...] plans the cuBLASLt shapes of a recorded list at start-up (record one
# with FPR_LT_DUMP on your own traffic; fpr/engine/mixed_cxx/mixed_cxx_ltwarm.py). Without it the plans are made lazily.
