# Site settings for the deploy/h200 scripts. Copy to deploy/h200/site.env (or point SITE_ENV at your copy) and edit.
# Every script here sources it first. Nothing secret belongs in this file: the API keys live in AUTH_CONFIG, outside
# the repository, and the TLS key in TLS_DIR.

# Scratch root: venv, caches, native builds, logs, run state.
export DS41H_HOME=${DS41H_HOME:-/srv/ds41h}
# This checkout. The server runs from it, so keep a frozen copy per release and point DS41H_REPO at the one to serve.
export DS41H_REPO=${DS41H_REPO:-$DS41H_HOME/ds41h}
export VIRTUAL_ENV=${VIRTUAL_ENV:-$DS41H_HOME/venv}
# Checkpoint (DeepSeek-V4.1-Flash-1017) and the converted-weight cache (scripts/prebuild_fpr.sh fills it).
export MODEL=${MODEL:-/srv/models/DeepSeek-V4.1-Flash-1017}
export DS41H_MODEL_DIR=$MODEL
export PHYS_WCACHE=${PHYS_WCACHE:-$DS41H_HOME/wcache}
# Native C++ modules built by deploy/h200/build_native.sh.
export DS41H_BUILD=${DS41H_BUILD:-$DS41H_HOME/build/native}
# Run state: active native.env copy, state file, pid files, pause flag, logs.
export DS41H_RUN=${DS41H_RUN:-$DS41H_HOME/run}
export DS41H_LOGS=${DS41H_LOGS:-$DS41H_HOME/logs}
export MAX_JOBS=${MAX_JOBS:-8}

# Public endpoint. TLS_DIR holds server.key, server.crt and ca.pem (the CA the health checks trust).
export PORT=${PORT:-8000}
export TLS_DIR=${TLS_DIR:-$DS41H_HOME/tls}
# vLLM --config YAML with the API keys ("api-key: [...]"; see deploy/h200/endpoint_auth.example.yaml). Required for
# the public endpoint; the warm-up requests use its first key.
export AUTH_CONFIG=${AUTH_CONFIG:-$DS41H_HOME/keys/endpoint_auth.yaml}
export SERVED_MODEL_NAME=${SERVED_MODEL_NAME:-deepseek-v41-flash-h200}

# Frontend: cxx = frontend_cxx (the C++ API server), py = vLLM's Python API server.
export NATIVE_FE=${NATIVE_FE:-cxx}
export FRONTEND_BIN=${FRONTEND_BIN:-$DS41H_REPO/frontend_cxx/build/frontend_cxx}
# frontend_cxx decodes WebP through the libwebp that Pillow bundles (its pillow.libs directory in the venv).
export FE_WEBP_LIB_DIR=${FE_WEBP_LIB_DIR:-$VIRTUAL_ENV/lib/python3.12/site-packages/pillow.libs}

# Optional: a UTC window in which switch_native.sh refuses planned switches (HHMM-HHMM, e.g. 0230-0630).
# Rollbacks by the guards are not affected.
export SWITCH_BLOCK_UTC=${SWITCH_BLOCK_UTC:-}
